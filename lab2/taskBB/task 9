@Composable
fun GreetingCard() {
    var name by remember { mutableStateOf("") }
    var submittedName by remember { mutableStateOf("") }

    Column(
        modifier = Modifier.fillMaxSize().background(ScreenBackground)
    ) {
        Column(
            modifier = Modifier.fillMaxWidth().background(Navy).padding(16.dp)
        ) {
            Text("Greeting", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 20.sp)
            Text("Task 9 - Text input", color = Color.White.copy(alpha = 0.75f), fontSize = 11.sp)
        }
        Box(Modifier.fillMaxWidth().height(3.dp).background(AndroidGreen))

        Column(Modifier.fillMaxWidth().padding(20.dp)) {
            OutlinedTextField(
                value = name,
                onValueChange = { name = it },
                label = { Text("Your name") },
                singleLine = true,
                modifier = Modifier.fillMaxWidth()
            )
            Spacer(Modifier.height(12.dp))
            Button(
                onClick = { submittedName = name.trim() },
                enabled = name.isNotBlank(),
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("Show greeting")
            }
            Spacer(Modifier.height(18.dp))
            Card(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp)
            ) {
                Column(Modifier.fillMaxWidth().padding(20.dp)) {
                    if (submittedName.isBlank()) {
                        Text("Your greeting will appear here.", color = Color.Gray)
                    } else {
                        Text("Marhaba, $submittedName!", fontSize = 24.sp, fontWeight = FontWeight.Bold, color = Navy)
                        Spacer(Modifier.height(8.dp))
                        Text("Your name has ${submittedName.length} letters.", color = Color.Gray)
                        Spacer(Modifier.height(12.dp))
                        Surface(color = AndroidGreen, shape = RoundedCornerShape(50)) {
                            Text(
                                "CSC 402 - Lab 2",
                                modifier = Modifier.padding(horizontal = 12.dp, vertical = 7.dp),
                                color = Navy,
                                fontWeight = FontWeight.SemiBold,
                                fontSize = 12.sp
                            )
                        }
                    }
                }
            }
        }
    }
}

