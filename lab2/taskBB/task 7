@Composable
fun StatItem(value: String, label: String) {
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text(value, fontWeight = FontWeight.Bold, fontSize = 16.sp, color = Navy)
        Text(label, fontSize = 10.sp, color = Color.Gray)
    }
}

@Composable
fun StudentChip(text: String, green: Boolean) {
    Surface(
        color = if (green) AndroidGreen.copy(alpha = 0.18f) else Color.LightGray.copy(alpha = 0.65f),
        shape = RoundedCornerShape(50)
    ) {
        Text(
            text,
            modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp),
            fontSize = 9.sp,
            fontWeight = FontWeight.SemiBold,
            color = if (green) Color(0xFF167A45) else Color.DarkGray
        )
    }
}

