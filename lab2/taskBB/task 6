@Composable
fun WelcomeBadge() {
    Surface(
        color = AndroidGreen,
        shape = RoundedCornerShape(50)
    ) {
        Text(
            text = "Built with Jetpack Compose",
            modifier = Modifier.padding(
                horizontal = 14.dp,
                vertical = 8.dp
            ),
            fontSize = 12.sp,
            fontWeight = FontWeight.SemiBold,
            color = Navy
        )
    }
}

@Composable
fun WelcomeScreen(
    modifier: Modifier = Modifier
) {
    Column(
        modifier = modifier
            .fillMaxSize()
            .background(ScreenBackground)
    ) {

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .background(Navy)
                .padding(
                    horizontal = 20.dp,
                    vertical = 16.dp
                )
        ) {
            Text(
                text = "CSC 402 Lab 2",
                color = Color.White,
                fontSize = 20.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                text = "Task 6 - My First Screen",
                color = Color.White.copy(alpha = 0.75f),
                fontSize = 12.sp
            )
        }

        Card(
            modifier = Modifier
                .fillMaxWidth()
                .padding(20.dp),
            shape = RoundedCornerShape(16.dp)
        ) {

            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(24.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {

                Box(
                    modifier = Modifier
                        .size(60.dp)
                        .clip(CircleShape)
                        .background(Navy),
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        text = "JU",
                        color = Color.White,
                        fontWeight = FontWeight.Bold,
                        fontSize = 20.sp
                    )
                }

                Spacer(modifier = Modifier.height(18.dp))

                Text(
                    text = "Hello, Jubail!",
                    fontSize = 26.sp,
                    fontWeight = FontWeight.Bold,
                    color = Navy
                )

                Spacer(modifier = Modifier.height(8.dp))

                Text(
                    text = "Welcome to CSC 402.",
                    color = Color.Gray
                )

                Text(
                    text = "This is your first Jetpack Compose screen.",
                    color = Color.Gray
                )

                Spacer(modifier = Modifier.height(18.dp))

                WelcomeBadge()
            }
        }
    }
}

