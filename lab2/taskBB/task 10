data class Course(
    val code: String,
    val title: String,
    val credits: Int,
    val days: String
)

@Composable
fun CourseRow(course: Course) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(14.dp)
    ) {
        Row(
            modifier = Modifier.fillMaxWidth().padding(12.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Box(
                modifier = Modifier.width(5.dp).height(58.dp).background(AndroidGreen)
            )
            Spacer(Modifier.width(10.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(course.code, fontWeight = FontWeight.Bold, color = Navy, fontSize = 13.sp)
                Text(
                    course.title,
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis,
                    fontSize = 14.sp
                )
                Text(course.days, color = Color.Gray, fontSize = 11.sp)
            }
            Spacer(Modifier.width(8.dp))
            Surface(color = AndroidGreen.copy(alpha = 0.18f), shape = RoundedCornerShape(50)) {
                Text(
                    "${course.credits} cr",
                    modifier = Modifier.padding(horizontal = 9.dp, vertical = 6.dp),
                    fontSize = 10.sp,
                    fontWeight = FontWeight.Bold,
                    color = Navy
                )
            }
        }
    }
}

@Composable
fun CourseListScreen() {
    val courses = remember {
        listOf(
            Course("CSC 402", "Mobile Application Programming", 3, "Mon / Wed"),
            Course("CSC 311", "Database Systems", 4, "Sun / Tue"),
            Course("CSC 340", "Operating Systems", 3, "Mon / Wed"),
            Course("MATH 202", "Discrete Mathematics", 3, "Sun / Thu"),
            Course("ENG 214", "Technical Writing", 2, "Tue"),
            Course("PHYS 105", "General Physics II", 4, "Sun / Tue"),
            Course("ISLM 101", "Islamic Culture", 2, "Thu")
        )
    }

    Column(Modifier.fillMaxSize().background(ScreenBackground)) {
        Column(Modifier.fillMaxWidth().background(Navy).padding(16.dp)) {
            Text("Course List", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 20.sp)
            Text("Task 10 - LazyColumn", color = Color.White.copy(alpha = 0.75f), fontSize = 11.sp)
        }
        Box(Modifier.fillMaxWidth().height(3.dp).background(AndroidGreen))

        LazyColumn(
            modifier = Modifier.fillMaxSize(),
            contentPadding = PaddingValues(16.dp),
            verticalArrangement = Arrangement.spacedBy(10.dp)
        ) {
            items(courses) { course -> CourseRow(course) }
        }
    }
}

