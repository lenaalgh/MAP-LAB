fun letterGrade(mark: Int): String = when {
    mark !in 0..100 -> "Invalid"
    mark >= 95 -> "A"
    mark >= 90 -> "A-"
    mark >= 85 -> "B+"
    mark >= 80 -> "B"
    mark >= 78 -> "B-"
    mark >= 75 -> "C+"
    mark >= 70 -> "C"
    mark >= 65 -> "C-"
    mark >= 60 -> "D"
    else -> "F"
}

fun status(mark: Int): String =
    if (mark >= 60) "Pass" else "Fail"

fun task3() {
    val marks = listOf(97, 88, 74, 61, 45, 130)

    for (mark in marks) {
        println("Mark %-3d  %-7s  (%s)".format(mark, letterGrade(mark), status(mark)))
    }
}

