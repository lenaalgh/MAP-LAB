fun greetStudent(name: String, course: String = "CSC 402"): String =
    "Welcome to $course, $name!"

fun finalMark(quizzes: Double, project: Double, finalExam: Double): Double =
    quizzes * 0.10 + project * 0.70 + finalExam * 0.20

fun printBanner(title: String, width: Int = 40) {

    println(title)

}

fun task2() {
    printBanner("lab 2 task 2")
    println(greetStudent("lena"))
    println(greetStudent("lena", "CSC 311"))

    val positional = finalMark(80.0, 90.0, 70.0)
    val named = finalMark(finalExam = 70.0, quizzes = 80.0, project = 90.0)

    println("Positional: $positional")
    println("Named:      $named")
}

